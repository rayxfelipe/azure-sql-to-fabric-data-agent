/// Synthetic appointment reporting aggregates. Source demographic groups with
/// fewer than 11 appointments are removed before this table is materialized.
/// Every appointment measure excludes those suppressed groups. Suppression is
/// upstream data removal, not a hidden model filter or a hidden subgroup.
table CommunityHealthAccess
	lineageTag: 865b9d8d-3032-4ab4-a426-a2f6cb08b109

	/// Reported appointments only. Excludes source groups suppressed for having
	/// fewer than 11 appointments. This is not the full source population count.
	measure 'Appointments' = SUM(CommunityHealthAccess[AppointmentCount])
		formatString: #,0

	measure 'Completed Appointments' = SUM(CommunityHealthAccess[CompletedCount])
		formatString: #,0

	measure 'No-Show Rate' =
			DIVIDE(
			    SUM(CommunityHealthAccess[NoShowCount]),
			    SUM(CommunityHealthAccess[AppointmentCount])
			)
		formatString: 0.0%

	/// Appointment-weighted wait over non-suppressed reporting groups only:
	/// total wait days divided by reported appointments, not group-average mean.
	measure 'Average Wait Days' = DIVIDE(SUM(CommunityHealthAccess[WaitDaysTotal]), [Appointments])
		formatString: 0.0

	measure 'Appointment Completion Rate' = DIVIDE([Completed Appointments], [Appointments])
		formatString: 0.0%

	column ScheduledDate
		dataType: dateTime
		formatString: Long Date
		summarizeBy: none
		sourceColumn: ScheduledDate

	column ServiceCategory
		dataType: string
		summarizeBy: none
		sourceColumn: ServiceCategory

	column FacilityNeighborhood
		dataType: string
		summarizeBy: none
		sourceColumn: FacilityNeighborhood

	column AgeBand
		dataType: string
		summarizeBy: none
		sourceColumn: AgeBand

	column DemographicGroup
		dataType: string
		summarizeBy: none
		sourceColumn: DemographicGroup

	column AppointmentCount
		dataType: int64
		summarizeBy: sum
		sourceColumn: AppointmentCount

	column CompletedCount
		dataType: int64
		summarizeBy: sum
		sourceColumn: CompletedCount

	column NoShowCount
		dataType: int64
		summarizeBy: sum
		sourceColumn: NoShowCount

	column AverageWaitDays
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: AverageWaitDays

	column WaitDaysTotal
		dataType: int64
		isHidden
		summarizeBy: sum
		sourceColumn: WaitDaysTotal

	partition CommunityHealthAccess = entity
		mode: directLake
		source
			entityName: CommunityHealthAccess
			schemaName: reporting
			expressionSource: DatabaseQuery
