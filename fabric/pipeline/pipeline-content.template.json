{
  "properties": {
    "description": "Loads curated community-health analytics from the mirrored Azure SQL source.",
    "activities": [
      {
        "name": "LoadCommunityHealthAnalytics",
        "type": "Script",
        "dependsOn": [],
        "policy": {
          "timeout": "0.01:00:00",
          "retry": 1,
          "retryIntervalInSeconds": 30,
          "secureInput": false,
          "secureOutput": false
        },
        "externalReferences": {
          "connection": "{{WAREHOUSE_CONNECTION_ID}}"
        },
        "typeProperties": {
          "database": {
            "name": "CommunityHealthAnalyticsWH"
          },
          "scripts": [
            {
              "type": "NonQuery",
              "text": "{{WAREHOUSE_LOAD_SQL}}"
            }
          ],
          "scriptBlockExecutionTimeout": "00:30:00"
        }
      }
    ]
  }
}
