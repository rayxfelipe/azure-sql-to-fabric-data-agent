{
  "properties": {
    "description": "Loads curated community-health analytics from the mirrored Azure SQL source.",
    "activities": [
      {
        "name": "LoadCommunityHealthAnalytics",
        "type": "Script",
        "dependsOn": [],
        "policy": {
          "timeout": "0.01:00:00",
          "retry": 6,
          "retryIntervalInSeconds": 30,
          "secureInput": false,
          "secureOutput": false
        },
        "linkedService": {
          "name": "CommunityHealthAnalyticsWH",
          "properties": {
            "type": "DataWarehouse",
            "typeProperties": {
              "endpoint": "{{WAREHOUSE_SQL_ENDPOINT}}",
              "artifactId": "{{WAREHOUSE_ID}}",
              "workspaceId": "{{WORKSPACE_ID}}"
            }
          }
        },
        "typeProperties": {
          "scripts": [
            {
              "type": "NonQuery",
              "text": "{{WAREHOUSE_LOAD_SQL}}"
            }
          ],
          "scriptBlockExecutionTimeout": "00:30:00"
        }
      }
    ]
  }
}
