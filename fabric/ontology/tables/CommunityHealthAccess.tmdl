table CommunityHealthAccess
	lineageTag: b879935d-0a0e-4e4c-90c7-f6c2e1456841
	measure 'Appointments' = SUM(CommunityHealthAccess[AppointmentCount])
	measure 'Average Wait Days' = DIVIDE(SUM(CommunityHealthAccess[WaitDaysTotal]), [Appointments])
	measure 'No-Show Rate' = DIVIDE(SUM(CommunityHealthAccess[NoShowCount]), [Appointments])

	column AccessGroupId
		lineageTag: 9836b833-7cd0-4622-84ba-8a824fe94811
