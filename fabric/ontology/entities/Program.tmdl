/// Synthetic service program hosted by a facility.
entity Program
	lineageTag: fca456d4-4e9a-40ba-8cf2-74ebed2b5e2a
	backingTable: Programs
	keyProperty: ProgramId

	property ProgramId
		dataType: int64
		backingConfiguration
			valueColumn: Programs.ProgramId

	property FacilityId
		dataType: int64
		backingConfiguration
			valueColumn: Programs.FacilityId

	property ProgramName
		dataType: string
		backingConfiguration
			valueColumn: Programs.ProgramName

	property ServiceCategory
		dataType: string
		backingConfiguration
			valueColumn: Programs.ServiceCategory

	synonym 'Service Program'
	synonym 'Service Line'
	annotation syntheticOnly = true
