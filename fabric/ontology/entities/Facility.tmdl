/// Synthetic service site. These are facility attributes, not client records.
entity Facility
	lineageTag: 57e99c19-3b37-4ee2-967e-2327466ddb37
	backingTable: Facilities
	keyProperty: FacilityId

	property FacilityId
		dataType: int64
		backingConfiguration
			valueColumn: Facilities.FacilityId

	property FacilityName
		dataType: string
		backingConfiguration
			valueColumn: Facilities.FacilityName

	property Neighborhood
		dataType: string
		backingConfiguration
			valueColumn: Facilities.Neighborhood

	property PlannedDailyCapacity
		dataType: int64
		backingConfiguration
			valueColumn: Facilities.PlannedDailyCapacity

	synonym Clinic
	synonym 'Service Site'
	annotation syntheticOnly = true
