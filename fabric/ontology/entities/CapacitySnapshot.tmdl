/// Non-person-level, synthetic facility capacity for one day.
entity CapacitySnapshot
	lineageTag: c690a1d4-5c3d-4b08-a011-f6b4739c59b3
	backingTable: FacilityCapacity
	keyProperty: CapacitySnapshotId

	property CapacitySnapshotId
		dataType: int64
		backingConfiguration
			valueColumn: FacilityCapacity.CapacitySnapshotId

	property FacilityId
		dataType: int64
		backingConfiguration
			valueColumn: FacilityCapacity.FacilityId

	property SnapshotDate
		dataType: dateTime
		backingConfiguration
			valueColumn: FacilityCapacity.SnapshotDate

	property AvailableSlots
		dataType: int64
		backingConfiguration
			valueColumn: FacilityCapacity.AvailableSlots

	property BookedSlots
		dataType: int64
		backingConfiguration
			valueColumn: FacilityCapacity.BookedSlots

	property UtilizationRate
		dataType: double
		backingConfiguration
			valueColumn: FacilityCapacity.UtilizationRate

	synonym 'Facility Capacity'
	synonym 'Utilization Snapshot'
	annotation syntheticOnly = true
